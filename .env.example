# Application
APP_ENV=development
APP_NAME=LinkedIn AI Autopilot
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# Database and queues
# Copy the exact Supabase direct or Session pooler URL from Dashboard > Connect,
# change postgresql:// to postgresql+psycopg://, and append ?sslmode=require.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
# Local Docker Compose: redis://redis:6379/0
# Oracle worker with Upstash: copy the exact TLS URL from Upstash, for example
# rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT:6379
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=270
CELERY_TASK_TIME_LIMIT_SECONDS=300
PUBLISHING_MAX_ATTEMPTS=5
PUBLISHING_RETRY_BASE_SECONDS=60
PUBLISHING_RETRY_MAX_SECONDS=3600
PUBLISHING_STALE_CLAIM_MINUTES=15

# Authentication (replace before enabling authentication)
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# LinkedIn OAuth (configured in Phase 4)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5173/settings/linkedin/callback
LINKEDIN_OAUTH_SCOPES=["openid","profile","email","w_member_social"]
LINKEDIN_API_VERSION=202609
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LINKEDIN_TOKEN_ENCRYPTION_KEY=

# NVIDIA Nemotron through the NVIDIA API Catalog / hosted NIM endpoint
AI_PROVIDER=nvidia
AI_MODEL=nvidia/YOUR_NEMOTRON_MODEL_ID
AI_API_KEY=
NVIDIA_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=4000
OPENAI_BASE_URL=https://api.openai.com/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
RESEARCH_PROVIDER=
RESEARCH_API_KEY=
RESEARCH_REQUEST_TIMEOUT_SECONDS=30
TAVILY_BASE_URL=https://api.tavily.com

# Supabase Storage S3 compatibility (server-side credentials only)
STORAGE_PROVIDER=supabase_s3
STORAGE_LOCAL_PATH=./storage
STORAGE_MAX_IMAGE_BYTES=10485760
STORAGE_MAX_VIDEO_BYTES=52428800
STORAGE_MAX_DOCUMENT_BYTES=10485760
STORAGE_BUCKET=linkedin-media
STORAGE_REGION=YOUR_SUPABASE_PROJECT_REGION
STORAGE_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
