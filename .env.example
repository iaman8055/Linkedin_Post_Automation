# Application
APP_ENV=development
APP_NAME=LinkedIn AI Autopilot
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# Database and queues
DATABASE_URL=postgresql+psycopg://linkedin:linkedin@postgres:5432/linkedin_autopilot
REDIS_URL=redis://redis:6379/0

# Authentication (replace before enabling authentication)
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# LinkedIn OAuth (configured in Phase 4)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/linkedin/callback

# External providers (configured in later phases)
AI_PROVIDER=
AI_API_KEY=
RESEARCH_PROVIDER=
RESEARCH_API_KEY=

# Object storage (configured in Phase 19)
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

